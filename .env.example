# ──────────────────────────────────────────────
# ticket-to-code — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env

# ── GitHub Integration ────────────────────────
# The secret you configured in your GitHub Webhook settings.
GITHUB_WEBHOOK_SECRET=your_secret_here

# Your GitHub App ID (for future authenticated API calls).
GITHUB_APP_ID=123456

# Personal Access Token (or App installation token) with permissions to:
#   - Trigger workflow_dispatch on your monorepo
#   - Create branches and pull requests
GITHUB_PAT=ghp_your_personal_access_token_here

# The full "owner/repo" of your monorepo (e.g., "your-org/mono")
GITHUB_REPO=your-org/your-monorepo

# ── Jira Integration ─────────────────────────
# Base URL of your Jira instance (Cloud or Server).
JIRA_BASE_URL=https://your-org.atlassian.net

# Jira API authentication — email + API token for Jira Cloud.
JIRA_USER_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Shared secret for verifying Jira webhook payloads (optional but recommended).
# If set, configure your Jira webhook URL to include ?token=<secret>:
#   https://your-server/api/webhooks/jira?token=your_jira_webhook_secret_here
# Requests without a matching token will be rejected with 403.
JIRA_WEBHOOK_SECRET=your_jira_webhook_secret_here

# ── LLM / AI Configuration ───────────────────
# LiteLLM model identifier. Examples:
#   openai/gpt-4o                           — OpenAI GPT-4o
#   anthropic/claude-3.5-sonnet             — Anthropic Claude (direct)
#   bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0  — AWS Bedrock Claude 3.5
#   bedrock/anthropic.claude-3-haiku-20240307-v1:0     — AWS Bedrock Claude 3 Haiku
#   bedrock/amazon.nova-pro-v1:0            — AWS Bedrock Nova Pro
#   bedrock/us.amazon.nova-pro-v1:0         — AWS Bedrock Nova Pro (cross-region)
#   ollama/llama3                           — Local Ollama
LITELLM_MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# ── AWS Bedrock credentials ──────────────────
# Option A: Static credentials (not recommended for production)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION_NAME=eu-west-1

# Option B: If running on EC2/ECS with an IAM role, leave the above blank
# and LiteLLM will use the instance profile automatically.

# Option C: AWS profile name (uses ~/.aws/credentials)
# AWS_PROFILE=your-profile-name

# API keys for other providers (leave blank if using Bedrock)
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-...

# ── Application Settings ─────────────────────
# Controls Python logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# The Jira/GitHub label that triggers TicketToCode task processing.
TICKET_LABEL=ai-task

# ── Code Platform (Execution Layer) ──────
# Which code platform to use for creating branches and PRs.
# Supported: "github" (default). Future: "bitbucket", "gitlab"
REPO_PLATFORM=github
